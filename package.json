{
  "name": "flashborn-browser",
  "version": "1.14.27",
  "description": "Corners browser with a fluid, responsive interface",
  "main": "src/main.js",
  "author": {
    "name": "Vas Sloutchevsky",
    "email": "sloutchevsky@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prepare:assets": "node scripts/prepare-native.js",
    "test": "node --test tests/*.test.js",
    "test:smoke": "node scripts/smoke.js",
    "dist": "npm run prepare:icon && npm run prepare:assets && electron-builder --win nsis --x64",
    "dist:signed": "npm run prepare:icon && npm run prepare:assets && electron-builder --win nsis --x64 --config.forceCodeSigning=true",
    "dist:azure": "node -e \"require('./electron-builder.azure.cjs')\" && npm run prepare:icon && npm run prepare:assets && electron-builder --config electron-builder.azure.cjs --win nsis --x64 --publish never && node scripts/verify-windows-signatures.js",
    "dist:portable": "npm run prepare:icon && npm run prepare:assets && electron-builder --win portable --x64",
    "test:files": "node scripts/file-ui-check.js",
    "test:refinements": "node scripts/refinements-check.js",
    "test:polish": "node scripts/polish-check.js",
    "test:privacy": "node scripts/privacy-check.js",
    "test:ui-update": "node scripts/ui-update-check.js",
    "test:predictions": "node scripts/predictions-check.js",
    "test:sidebar": "node scripts/sidebar-check.js",
    "test:window": "node scripts/window-check.js",
    "test:playback": "node scripts/playback-check.js",
    "test:toolbar": "node scripts/toolbar-check.js",
    "test:input-stability": "node scripts/input-stability-check.js",
    "test:summaries": "node scripts/summary-check.js",
    "prepare:icon": "node scripts/create-icon.js",
    "test:website": "node scripts/website-check.js",
    "test:package": "node scripts/verify-package.js",
    "test:isolation": "node scripts/isolation-check.js",
    "test:theme-color": "node scripts/theme-color-check.js",
    "test:page-colors": "node scripts/page-colors-check.js",
    "test:uploads": "node scripts/upload-drop-check.js",
    "test:extensions": "node scripts/extensions-check.js",
    "test:ui-stability": "node scripts/ui-stability-check.js",
    "test:chrome-polish": "node scripts/chrome-polish-check.js",
    "test:link-order": "node scripts/link-order-check.js",
    "test:flash-visibility": "node scripts/flash-visibility-check.js",
    "test:library-support": "node scripts/library-support-check.js",
    "test:flash-reload": "node scripts/flash-reload-check.js",
    "test:navigation-release": "node scripts/navigation-release-check.js",
    "test:portfolio-polish": "node scripts/portfolio-polish-check.js",
    "test:special-pages": "node scripts/special-pages-check.js",
    "test:tab-presentation": "node scripts/tab-presentation-check.js",
    "test:flash-layering": "node scripts/flash-layering-check.js",
    "test:flash-desktop": "node scripts/flash-desktop-composition-check.js",
    "test:menu-toggle": "node scripts/menu-toggle-check.js",
    "test:firstborn-tabs": "node scripts/firstborn-tabs-check.js",
    "test:tab-cache": "node scripts/tab-cache-collapse-check.js",
    "build:library": "node scripts/build-library-page.cjs",
    "test:hosted-library": "node scripts/hosted-library-check.js",
    "test:library-pane": "node scripts/library-pane-check.js",
    "test:sidebar-navigation": "node scripts/sidebar-navigation-check.js",
    "test:collection-thumbnails": "node scripts/collection-thumbnails-check.js",
    "test:window-preview": "node scripts/window-preview-check.js",
    "test:window-activation": "node scripts/window-activation-check.js",
    "test:window-border": "node scripts/window-border-check.js",
    "test:window-motion": "node scripts/window-motion-check.js",
    "test:flash-resize": "node scripts/flash-resize-check.js",
    "test:desktop-artifact": "node scripts/desktop-artifact-check.js",
    "test:menu-selection": "node scripts/menu-selection-check.js",
    "test:sidebar-flash-edge": "node scripts/sidebar-flash-edge-check.js",
    "test:support-page": "node scripts/support-page-check.js",
    "test:menu-motion": "node scripts/menu-motion-check.js",
    "test:page-fields": "node scripts/page-fields-check.js",
    "test:appearance-thumbnails": "node scripts/appearance-thumbnails-check.js",
    "test:four-themes": "node scripts/four-theme-check.js"
  },
  "dependencies": {
    "koffi": "3.3.2",
    "lzma": "2.3.2",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.56.1"
  },
  "build": {
    "appId": "com.flashborn.browser",
    "productName": "Corners",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/native-runtime",
        "to": "native-runtime"
      },
      {
        "from": "vendor/native-flash",
        "to": "native-flash"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Corners-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Corners",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "assets/installer.nsh",
      "packElevateHelper": false
    },
    "copyright": "© 2026 Vas Sloutchevsky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sloutchevsky/Corners.git"
  },
  "homepage": "https://github.com/sloutchevsky/Corners",
  "bugs": {
    "url": "https://github.com/sloutchevsky/Corners/issues"
  }
}
