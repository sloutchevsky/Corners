{
  "name": "flashborn-browser",
  "version": "1.7.1",
  "description": "A minimal dark Windows browser with native Adobe Flash playback",
  "main": "src/main.js",
  "author": {
    "name": "Vas Sloutchevsky",
    "email": "sloutchevsky@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prepare:assets": "node scripts/prepare-native.js",
    "test": "node --test tests/*.test.js",
    "test:smoke": "node scripts/smoke.js",
    "dist": "npm run prepare:icon && npm run prepare:assets && electron-builder --win nsis --x64",
    "dist:signed": "npm run prepare:icon && npm run prepare:assets && electron-builder --win nsis --x64 --config.forceCodeSigning=true",
    "dist:portable": "npm run prepare:icon && npm run prepare:assets && electron-builder --win portable --x64",
    "test:files": "node scripts/file-ui-check.js",
    "test:refinements": "node scripts/refinements-check.js",
    "test:polish": "node scripts/polish-check.js",
    "test:privacy": "node scripts/privacy-check.js",
    "test:ui-update": "node scripts/ui-update-check.js",
    "test:predictions": "node scripts/predictions-check.js",
    "test:eyedropper": "node scripts/eyedropper-check.js",
    "test:sidebar": "node scripts/sidebar-check.js",
    "prepare:icon": "node scripts/create-icon.js"
  },
  "dependencies": {
    "koffi": "3.3.2"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.56.1"
  },
  "build": {
    "appId": "com.flashborn.browser",
    "productName": "Flashborn",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/native-runtime",
        "to": "native-runtime"
      },
      {
        "from": "vendor/native-flash",
        "to": "native-flash"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Flashborn-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flashborn",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "assets/installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": "swf",
        "name": "Flash movie",
        "description": "Flash movie or game",
        "role": "Viewer",
        "icon": "assets/icon.ico"
      }
    ],
    "copyright": "© 2026 Vas Sloutchevsky"
  }
}
